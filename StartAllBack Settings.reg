Windows Registry Editor Version 5.00
; Fichier créé et edité par el.s212 le 27/09/2026 et mis à jour le 27/09/2026

; Barre des taches style plain8, espace entre les icones taille S (taille M de base)
[HKEY_CURRENT_USER\Software\StartIsBack]
"TaskbarSpacierIcons"=dword:ffffffff
"TaskbarStyle"="Plain8.msstyles"

; Ne pas combiner les boutons de la barre des taches
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"TaskbarGlomLevel"=dword:00000002

[HKEY_CURRENT_USER\Software\StartIsBack]
"TaskbarGrouping"=dword:00000001

; Ne pas afficher le pdp de l'utilisateur
[HKEY_CURRENT_USER\Software\StartIsBack]
"HideUserFrame"=dword:00000001

; Dossier menu demarrer
[HKEY_CURRENT_USER\Software\StartIsBack]
"Start_RightPaneIcons"=dword:00000000
"Start_ShowUser"=dword:00000000
"Start_ShowMyDocs"=dword:00000000
"Start_ShowMyPics"=dword:00000000
"Start_ShowMyMusic"=dword:00000000
"Start_ShowRecentDocs"=dword:00000000
"Start_ShowRecentRun"=dword:00000000
"Start_ShowRun"=dword:00000000
"Start_ShowCommandPrompt"=dword:00000001

; Style menu demarrer
[HKEY_CURRENT_USER\Software\StartIsBack]
"AlterStyle"="Plain8.msstyles"

; Icones de la barre d'etat
[HKEY_CURRENT_USER\Software\StartIsBack]
"SysTrayStyle"=dword:00000002
"SysTrayLocation"=dword:00000000
"SysTrayInputSwitch"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer]
"EnableAutoTray"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"ShowNotificationIcon"=dword:00000000

[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Dsh]
"AllowNewsAndInterests"=dword:00000000

; Explorateur de fichiers
[HKEY_CURRENT_USER\Software\StartIsBack]
"FrameStyle"=dword:00000000
"RestyleIcons"=dword:00000000