Windows Registry Editor Version 5.00

; PANNEAU DE CONFIGURATION


; ---DATE ET HEURE---
; Désactiver "M'avertir lorsque l'horloge est modifée"
[HKEY_CURRENT_USER\Control Panel\TimeDate]
"DstNotification"=dword:00000000


;--- OPTIONS D'ALIMENTATION---
; Désactiver "Verrouiller", "Veille", "Hibernation" dans le menu d'alimentation
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Explorer\FlyoutMenuSettings]
"ShowLockOption"=dword:00000000
"ShowSleepOption"=dword:00000000
"ShowHibernateOption"=dword:00000000


; ---OPTIONS D'ERGORNOMIE---
; Désactiver "Lire cette section à haute voix" et "Toujours analyser cette section"
[HKEY_CURRENT_USER\Software\Microsoft\Ease of Access]
"selfscan"=dword:00000000
"selfvoice"=dword:00000000

; Configurer les touches souris
[HKEY_CURRENT_USER\Control Panel\Accessibility\MouseKeys]
"Flags"="130"
"MaximumSpeed"="10"
"TimeToMaximumSpeed"="5000"

[HKEY_CURRENT_USER\Control Panel\Accessibility]
"Sound on Activation"=dword:0
"Warning Sounds"=dword:0

; Désactiver les touches rémanantes
[HKEY_CURRENT_USER\Control Panel\Accessibility\StickyKeys]
"Flags"="482"


; ---OPTIONS DE L'EXPLORATEUR DE FICHIERS---
; Désactiver l'affichage des fichiers, des dossiers récemment utilisés et des fichiers de Office.com
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer]
"ShowCloudFilesInQuickAccess"=dword:00000000
"ShowFrequent"=dword:00000000
"ShowRecent"=dword:00000000

; Ouvrir l'Explorateur de fichiers dans "Ce PC", affichier les fichiers cachés et les extensions des fichiers, activer l'affichage compact, désactiver l'assistant partage et les notifications du fournisseur de synchronisation
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"Hidden"=dword:00000001
"HideFileExt"=dword:00000000
"LaunchTo"=dword:00000001
"SharingWizardOn"=dword:00000000
"ShowSyncProviderNotifications"=dword:00000000
"UseCompactMode"=dword:00000001

; Enlever Accueil, Galerie et Réseau de l'explorateur de fichiers
[HKEY_CURRENT_USER\Software\Classes\CLSID\{f874310e-b6b7-47dc-bc84-b9e6b38f5903}]
"System.IsPinnedToNameSpaceTree"=dword:00000000

[HKEY_CURRENT_USER\Software\Classes\CLSID\{e88865ea-0e1c-4e20-9aa6-edcd0212c87c}]
"System.IsPinnedToNameSpaceTree"=dword:00000000

[HKEY_CURRENT_USER\Software\Classes\CLSID\{F02C1A0D-BE21-4350-88B0-7367FC96EF3C}]
"System.IsPinnedToNameSpaceTree"=dword:00000000


; ---SON---
; Désactiver le son au démarrage
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Authentication\LogonUI\BootAnimation]
"DisableStartupSound"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\EditionOverrides]
"UserSetting_DisableStartupSound"=dword:00000001

; "Ne rien faire" quand Windows détecte des communications
[HKEY_CURRENT_USER\Software\Microsoft\Multimedia\Audio]
"UserDuckingPreference"=dword:00000003


; ---SOURIS---
; Désactiver l'acceleration souris
[HKEY_CURRENT_USER\Control Panel\Mouse]
"MouseSpeed"="0"
"MouseThreshold1"="0"
"MouseThreshold2"="0"



; PARAMETRES WINDOWS



; ---SYSTEME---

; ECRAN
; Activer les optimisations pour les jeux en mode fenêtré et désactiver VRR
[HKEY_CURRENT_USER\Software\Microsoft\DirectX\UserGpuPreferences]
"DirectXUserGlobalSettings"="VRROptimizeEnable=0;SwapEffectUpgradeEnable=1"

; Activer HAGS
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\GraphicsDrivers]
"HwSchMode"=dword:00000002


; NOTIFICATIONS
; Désactiver les notifications
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\PushNotifications]
"ToastEnabled"=dword:00000000
"LockScreenToastEnabled"=dword:00000000

[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications\Settings]
"NOC_GLOBAL_SETTING_ALLOW_CRITICAL_TOASTS_ABOVE_LOCK"=dword:00000000
"NOC_GLOBAL_SETTING_ALLOW_NOTIFICATION_SOUND"=dword:00000000
"NOC_GLOBAL_SETTING_ALLOW_TOASTS_ABOVE_LOCK"=dword:00000000

